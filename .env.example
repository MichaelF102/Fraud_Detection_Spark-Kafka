# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=financial_transactions
KAFKA_TOPIC_DEAD_LETTER=transactions_dead_letter
KAFKA_CONSUMER_GROUP=spark-fraud-detector

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraud_detection
POSTGRES_USER=fraud_admin
POSTGRES_PASSWORD=fraud_secure_pass_2026
POSTGRES_MAX_CONNECTIONS=20

# Stream Processing Configuration
STREAM_TRIGGER_INTERVAL=5 seconds
WATERMARK_DURATION=2 minutes
CHECKPOINT_PATH=/app/checkpoints
LAKE_BRONZE_PATH=/app/lake/bronze
LAKE_SILVER_PATH=/app/lake/silver
FRAUD_RULES_CONFIG_PATH=/app/config/fraud_rules.yaml

# Producer Simulation Configuration
TRANSACTION_RATE=10
PRODUCER_SEED=42
INJECT_MALFORMED_RATIO=0.03
INJECT_FRAUD_RATIO=0.15

# Streamlit Dashboard Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
